<!-- Surface-mode decode rates measured on scarlet with 30 fps high-detail clips. -->
<MediaCodecs>
    <Decoders>
        <MediaCodec name="c2.v4l2.avc.decoder" type="video/avc" update="true">
            <Limit name="measured-frame-rate-320x240" range="160-240" />
            <Limit name="measured-frame-rate-720x480" range="160-240" />
            <Limit name="measured-frame-rate-1280x720" range="130-190" />
            <Limit name="measured-frame-rate-1920x1080" range="59-82" />
            <Limit name="measured-frame-rate-3840x2160" range="21-30" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.vp8.decoder" type="video/x-vnd.on2.vp8" update="true">
            <Limit name="measured-frame-rate-320x240" range="165-235" />
            <Limit name="measured-frame-rate-720x480" range="145-205" />
            <Limit name="measured-frame-rate-1280x720" range="70-98" />
            <Limit name="measured-frame-rate-1920x1080" range="36-52" />
        </MediaCodec>
        <MediaCodec name="c2.v4l2.vp9.decoder" type="video/x-vnd.on2.vp9" update="true">
            <Limit name="measured-frame-rate-320x240" range="177-256" />
            <Limit name="measured-frame-rate-720x480" range="153-215" />
            <Limit name="measured-frame-rate-1280x720" range="131-198" />
            <Limit name="measured-frame-rate-1920x1080" range="64-88" />
            <Limit name="measured-frame-rate-3840x2160" range="24-38" />
        </MediaCodec>
    </Decoders>
</MediaCodecs>
