# Android fstab for Scarlet. Not an A/B device, so there is no slotselect.
# userdata is mounted in first stage and is writable. The finished Trogdor
# tree uses latemount; that left /data read-only on the earlier bringup.
system                                                  /system         erofs   ro                                                      wait,logical,first_stage_mount
vendor                                                  /vendor         erofs   ro                                                      wait,logical,first_stage_mount
system_ext                                              /system_ext     erofs   ro                                                      wait,logical,first_stage_mount
product                                                 /product        erofs   ro                                                      wait,logical,first_stage_mount
system_dlkm                                             /system_dlkm    erofs   ro                                                      wait,logical,first_stage_mount
vendor_dlkm                                             /vendor_dlkm    erofs   ro                                                      wait,logical,first_stage_mount

/dev/block/by-name/userdata                             /data           f2fs    nodev,noatime,nosuid,inlinecrypt,reserve_root=32768     wait,formattable,first_stage_mount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,check,fscompress,checkpoint=fs
/dev/block/by-name/userdata                             /data           ext4    discard,noatime,noauto_da_alloc,data=ordered,user_xattr,barrier=1,inlinecrypt   wait,formattable,first_stage_mount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota
/dev/block/by-name/metadata                             /metadata       ext4    noatime,nosuid,nodev,discard                            wait,formattable,first_stage_mount,check
/dev/block/by-name/misc                                 /misc           emmc    defaults                                                defaults

/dev/block/zram0                                        none            swap    defaults                                                zramsize=75%
