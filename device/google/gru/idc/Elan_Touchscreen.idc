# Copyright (C) 2026 The LineageOS Project
#
# Elan Touchscreen (elants_i2c, ekth3500) on Scarlet registers with
# Vendor=0000 Product=0000 Name="Elan Touchscreen", so EventHub looks up
# Elan_Touchscreen.idc by canonical device name.
#

device.internal = 1
touch.deviceType = touchScreen
touch.orientationAware = 1
