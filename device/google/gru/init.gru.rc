import /vendor/etc/init/hw/init.mainline.rc

# init imports this path. Without mount_all, nothing queues nonencrypted,
# so class main never starts. Default mode (not --early) queues that trigger.
# first_stage entries are already mounted and skipped; the return is
# DEV_NOT_ENCRYPTABLE, which matches this unencrypted userdata.

on early-init
    write /sys/module/firmware_class/parameters/path /vendor/firmware
    # Battery stats swaps BPF maps through a PF_KEY socket. That close()
    # calls synchronize_rcu(). CONFIG_NET_KEY=m, so the family is missing
    # until this module is loaded, and the swap then kills system_server.
    insmod /vendor/lib/af_key.ko
    # ConnectivityService tears down live sockets via NETLINK_SOCK_DIAG
    # (SOCK_DIAG_BY_FAMILY) when networks disconnect on suspend/resume;
    # without inet_diag/tcp_diag, NetlinkUtils waits 30s on EAGAIN timeouts.
    insmod /vendor/lib/inet_diag.ko
    insmod /vendor/lib/tcp_diag.ko
    insmod /vendor/lib/udp_diag.ko
    insmod /vendor/lib/raw_diag.ko
    insmod /vendor/lib/fuse.ko
    insmod /vendor/lib/rockchip_thermal.ko
    insmod /vendor/lib/cpufreq-dt.ko
    insmod /vendor/lib/rockchip-dfi.ko
    insmod /vendor/lib/rk3399_dmc.ko
    insmod /vendor/lib/i2c-hid.ko
    insmod /vendor/lib/i2c-hid-of.ko
    insmod /vendor/lib/gpio_keys.ko
    insmod /vendor/lib/kfifo_buf.ko
    insmod /vendor/lib/industrialio-triggered-buffer.ko
    insmod /vendor/lib/cros-ec-sensorhub.ko
    insmod /vendor/lib/cros_ec_sensors_core.ko
    insmod /vendor/lib/cros_ec_sensors.ko
    insmod /vendor/lib/cros_usbpd-charger.ko
    insmod /vendor/lib/rtc-cros-ec.ko
    insmod /vendor/lib/lz4.ko
    insmod /vendor/lib/zram.ko
    insmod /vendor/lib/drm_shmem_helper.ko
    insmod /vendor/lib/gpu-sched.ko
    insmod /vendor/lib/panfrost.ko
    insmod /vendor/lib/rfkill.ko
    insmod /vendor/lib/libarc4.ko
    insmod /vendor/lib/arc4.ko
    insmod /vendor/lib/ccm.ko
    insmod /vendor/lib/cmac.ko
    insmod /vendor/lib/aes-ce-cipher.ko
    insmod /vendor/lib/aes-ce-ccm.ko
    insmod /vendor/lib/aes-ce-blk.ko
    insmod /vendor/lib/cfg80211.ko
    insmod /vendor/lib/mac80211.ko
    insmod /vendor/lib/ath.ko
    insmod /vendor/lib/ath10k_core.ko
    insmod /vendor/lib/ath10k_pci.ko
    insmod /vendor/lib/ecc.ko
    insmod /vendor/lib/ecdh_generic.ko
    insmod /vendor/lib/uhid.ko
    insmod /vendor/lib/bluetooth.ko
    insmod /vendor/lib/rfcomm.ko
    insmod /vendor/lib/bnep.ko
    insmod /vendor/lib/hidp.ko
    insmod /vendor/lib/btbcm.ko
    insmod /vendor/lib/btintel.ko
    insmod /vendor/lib/btrtl.ko
    insmod /vendor/lib/btmtk.ko
    insmod /vendor/lib/btqca.ko
    insmod /vendor/lib/btusb.ko
    insmod /vendor/lib/soundcore.ko
    insmod /vendor/lib/snd.ko
    insmod /vendor/lib/snd-timer.ko
    insmod /vendor/lib/snd-pcm.ko
    insmod /vendor/lib/snd-pcm-dmaengine.ko
    insmod /vendor/lib/snd-soc-core.ko
    insmod /vendor/lib/snd-soc-rockchip-i2s.ko
    insmod /vendor/lib/snd-soc-rockchip-spdif.ko
    insmod /vendor/lib/snd-soc-max98357a.ko
    insmod /vendor/lib/snd-soc-da7219.ko
    insmod /vendor/lib/snd-soc-rl6231.ko
    insmod /vendor/lib/snd-soc-rt5514-spi.ko
    insmod /vendor/lib/snd-soc-rt5514.ko
    insmod /vendor/lib/snd-soc-dmic.ko
    insmod /vendor/lib/snd-soc-hdmi-codec.ko
    insmod /vendor/lib/snd-soc-rk3399-gru-sound.ko
    insmod /vendor/lib/mc.ko
    insmod /vendor/lib/videodev.ko
    insmod /vendor/lib/videobuf2-common.ko
    insmod /vendor/lib/videobuf2-memops.ko
    insmod /vendor/lib/videobuf2-dma-contig.ko
    insmod /vendor/lib/videobuf2-v4l2.ko
    insmod /vendor/lib/videobuf2-vmalloc.ko
    insmod /vendor/lib/v4l2-async.ko
    insmod /vendor/lib/v4l2-fwnode.ko
    insmod /vendor/lib/ov5695.ko
    insmod /vendor/lib/ov2685.ko
    insmod /vendor/lib/rockchip-isp1.ko
    insmod /vendor/lib/v4l2-mem2mem.ko
    insmod /vendor/lib/v4l2-h264.ko
    insmod /vendor/lib/v4l2-vp9.ko
    insmod /vendor/lib/hantro-vpu.ko
    insmod /vendor/lib/rockchip-vdec.ko
    insmod /vendor/lib/snd-hwdep.ko
    insmod /vendor/lib/snd-seq-device.ko
    insmod /vendor/lib/snd-rawmidi.ko
    insmod /vendor/lib/snd-usbmidi-lib.ko
    insmod /vendor/lib/snd-usb-audio.ko
    # usbdrd_dwc3_0 is dr_mode=host, so there is no UDC. The gadget HAL
    # aborts when sys.usb.controller is empty. init.mainline.usb.rc would
    # otherwise set configfs to 2 and restart that HAL forever.
    setprop vendor.usb.configfs 0
    # sys.use_memfd and sys.brightness.disable_gamma_conversion are system
    # properties. They are set from the product makefile. vendor_init cannot
    # set them once SELinux is enforcing.
    setprop debug.renderengine.backend skiaglthreaded
    setprop debug.hwui.renderer skiagl

on init
    write /sys/block/zram0/comp_algorithm lz4

on fs
    mount_all /vendor/etc/fstab.${ro.hardware}
    swapon_all /vendor/etc/fstab.${ro.hardware}

# fbcon is bound to the DSI panel by this point. hwcomposer starts later, in
# class hal. If the framebuffer console still holds the primary plane, the
# composer finds no pipeline and stays headless, and the panel keeps the
# last console frame. Unbind here, before that class starts.
on post-fs
    exec_start expand_userdata
    write /sys/class/vtconsole/vtcon0/bind 0
    write /sys/class/vtconsole/vtcon1/bind 0
    chown bluetooth bluetooth /dev/rfkill
    chmod 0660 /dev/rfkill
    chown uhid uhid /dev/uhid
    chmod 0660 /dev/uhid
    chown system system /dev/iio:device0
    chmod 0660 /dev/iio:device0
    chown system system /sys/bus/iio/devices/iio:device0/buffer/enable
    chmod 0660 /sys/bus/iio/devices/iio:device0/buffer/enable
    chown system system /sys/bus/iio/devices/iio:device0/buffer/length
    chmod 0660 /sys/bus/iio/devices/iio:device0/buffer/length
    chown system system /sys/bus/iio/devices/iio:device0/buffer/hwfifo_timeout
    chmod 0660 /sys/bus/iio/devices/iio:device0/buffer/hwfifo_timeout
    chown system system /sys/bus/iio/devices/iio:device0/sampling_frequency
    chmod 0660 /sys/bus/iio/devices/iio:device0/sampling_frequency
    chown system system /sys/bus/iio/devices/iio:device0/scan_elements/in_accel_x_en
    chmod 0660 /sys/bus/iio/devices/iio:device0/scan_elements/in_accel_x_en
    chown system system /sys/bus/iio/devices/iio:device0/scan_elements/in_accel_y_en
    chmod 0660 /sys/bus/iio/devices/iio:device0/scan_elements/in_accel_y_en
    chown system system /sys/bus/iio/devices/iio:device0/scan_elements/in_accel_z_en
    chmod 0660 /sys/bus/iio/devices/iio:device0/scan_elements/in_accel_z_en
    chown system system /sys/bus/iio/devices/iio:device0/scan_elements/in_timestamp_en
    chmod 0660 /sys/bus/iio/devices/iio:device0/scan_elements/in_timestamp_en
    chown system system /dev/iio:device1
    chmod 0660 /dev/iio:device1
    chown system system /sys/bus/iio/devices/iio:device1/buffer/enable
    chmod 0660 /sys/bus/iio/devices/iio:device1/buffer/enable
    chown system system /sys/bus/iio/devices/iio:device1/buffer/length
    chmod 0660 /sys/bus/iio/devices/iio:device1/buffer/length
    chown system system /sys/bus/iio/devices/iio:device1/buffer/hwfifo_timeout
    chmod 0660 /sys/bus/iio/devices/iio:device1/buffer/hwfifo_timeout
    chown system system /sys/bus/iio/devices/iio:device1/sampling_frequency
    chmod 0660 /sys/bus/iio/devices/iio:device1/sampling_frequency
    chown system system /sys/bus/iio/devices/iio:device1/scan_elements/in_anglvel_x_en
    chmod 0660 /sys/bus/iio/devices/iio:device1/scan_elements/in_anglvel_x_en
    chown system system /sys/bus/iio/devices/iio:device1/scan_elements/in_anglvel_y_en
    chmod 0660 /sys/bus/iio/devices/iio:device1/scan_elements/in_anglvel_y_en
    chown system system /sys/bus/iio/devices/iio:device1/scan_elements/in_anglvel_z_en
    chmod 0660 /sys/bus/iio/devices/iio:device1/scan_elements/in_anglvel_z_en
    chown system system /sys/bus/iio/devices/iio:device1/scan_elements/in_timestamp_en
    chmod 0660 /sys/bus/iio/devices/iio:device1/scan_elements/in_timestamp_en

on zygote-start
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi

on boot && property:service.adb.tcp.port=5555
    start adbd

# Drop the console to warnings after the UI is up. The cmdline starts at 4.
on property:sys.boot_completed=1
    # /system/bin/sh is shell_exec and transitions to shell. The tools themselves
    # are system_file, which init is not allowed to execute in its own domain.
    exec_background - root root -- /system/bin/sh -c "/system/bin/pm enable com.android.bluetooth"
    exec_background - root root -- /system/bin/sh /vendor/bin/boot_settings.sh
    exec_background - root root -- /system/bin/sh -c "/system/bin/settings put secure show_ime_with_hard_keyboard 1"
    exec_background - root root -- /system/bin/sh -c "/system/bin/settings put global override_desktop_experience_features 1"
    exec_background - root audio -- /system/bin/tinymix2 -D 0 set "Out DAIR Mux" 0
    write /proc/sys/kernel/printk "3 4 1 3"

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
                       -O/data/vendor/wifi/wpa/sockets \
                       -Dnl80211 -g@android:wpa_wlan0
    interface aidl android.hardware.wifi.supplicant.ISupplicant/default
    socket wpa_wlan0 dgram 660 wifi wifi
    group wifi net_raw net_admin
    class main
    disabled
    oneshot
    user root

service expand_userdata /vendor/bin/expand_userdata.sh
    class core
    user root
    group root system
    disabled
    oneshot
