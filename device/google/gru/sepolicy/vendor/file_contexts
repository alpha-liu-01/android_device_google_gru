# mmcblk0 is the external microSD (fe320000.mmc). mmcblk1 is the internal eMMC.
/dev/block/mmcblk0p3          u:object_r:metadata_block_device:s0
/dev/block/mmcblk0p4          u:object_r:misc_block_device:s0
/dev/block/mmcblk0p5          u:object_r:super_block_device:s0
/dev/block/mmcblk0p6          u:object_r:userdata_block_device:s0
/dev/block/mmcblk0            u:object_r:gru_sd_device:s0
/dev/block/by-name/metadata   u:object_r:metadata_block_device:s0
/dev/block/by-name/misc       u:object_r:misc_block_device:s0
/dev/block/by-name/super      u:object_r:super_block_device:s0
/dev/block/by-name/userdata   u:object_r:userdata_block_device:s0

# Media controller nodes. /dev/video* is already video_device.
/dev/media[0-9]*              u:object_r:video_device:s0
/dev/v4l-subdev[0-9]*         u:object_r:video_device:s0

/vendor/bin/expand_userdata\.sh    u:object_r:gru_expand_exec:s0
/vendor/bin/blkpg_resize           u:object_r:gru_expand_exec:s0
