type gru_expand, domain;
type gru_expand_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(gru_expand)

# sgdisk, resize.f2fs and mount live in /system.
typeattribute gru_expand vendor_executes_system_violators;

allow gru_expand gru_expand_exec:file { execute execute_no_trans r_file_perms };
allow gru_expand shell_exec:file { execute execute_no_trans r_file_perms };
allow gru_expand {
    sgdisk_exec
    e2fs_exec
    fsck_exec
    system_file
}:file { execute execute_no_trans r_file_perms };

allow gru_expand kmsg_device:chr_file { getattr open write };
allow gru_expand proc_mounts:file r_file_perms;
allow gru_expand proc_swaps:file r_file_perms;
r_dir_file(gru_expand, sysfs_devices_block)

allow gru_expand block_device:dir r_dir_perms;
allow gru_expand gru_sd_device:blk_file rw_file_perms;
allow gru_expand userdata_block_device:blk_file rw_file_perms;
allow gru_expand metadata_file:dir rw_dir_perms;
allow gru_expand metadata_file:file create_file_perms;
