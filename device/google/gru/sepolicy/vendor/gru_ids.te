type gru_ids, domain;
type gru_ids_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(gru_ids)

# The script is executed through /system/bin/sh and toybox.
typeattribute gru_ids vendor_executes_system_violators;
allow gru_ids gru_ids_exec:file { execute execute_no_trans r_file_perms };
allow gru_ids shell_exec:file { execute execute_no_trans r_file_perms };
allow gru_ids toolbox_exec:file { execute execute_no_trans r_file_perms };
allow gru_ids system_file:file { execute execute_no_trans r_file_perms };

# Walk /sys/firmware/vpd/ro and read only serial_number.
allow gru_ids sysfs:dir search;
allow gru_ids vendor_sysfs_vpd_serial:file r_file_perms;

# set_prop() also grants a read of the property file. serialno_prop
# reads are limited to a few domains. The socket write is enough:
# an unset ro.* can be set once, and a later boot is left alone.
unix_socket_connect(gru_ids, property, init)
allow gru_ids serialno_prop:property_service set;
