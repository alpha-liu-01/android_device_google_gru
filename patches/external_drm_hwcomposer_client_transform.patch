 bool Backend::IsClientLayer(const HwcDisplay* display, const HwcLayer* layer) {
-  return !HardwareSupportsLayerType(layer->GetSfType()) ||
-         !layer->IsLayerUsableAsDevice() || display->CtmByGpu() ||
-         (layer->GetLayerData().pi.RequireScalingOrPhasing() &&
-          display->ForcedScalingWithGpu());
+  if (!HardwareSupportsLayerType(layer->GetSfType()) ||
+      !layer->IsLayerUsableAsDevice() || display->CtmByGpu() ||
+      (layer->GetLayerData().pi.RequireScalingOrPhasing() &&
+       display->ForcedScalingWithGpu()))
+    return true;
+
+  /* VOP planes have no 90-degree rotation. A layer that none of them can
+   * scan out has to be client. Leaving it in the device list makes
+   * CreateDrmKmsPlan fail and the backend then flattens every layer.
+   * The property stays off so a newly installed binary matches the
+   * previous compositor until the check is requested. */
+  if (!Properties::ClientUnsupportedTransform())
+    return false;
+
+  const auto transform = layer->GetLayerData().pi.transform;
+  const auto planes = display->GetPipe().GetUsablePlanes().first;
+  if (planes.empty())
+    return false;
+  for (const auto& plane : planes) {
+    if (plane && plane->Get() &&
+        plane->Get()->SupportsLayerTransform(transform))
+      return false;
+  }
+  return true;
 }
 
