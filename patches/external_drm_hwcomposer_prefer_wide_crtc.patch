+static int CountPlanesForCrtc(DrmDevice &dev, const DrmCrtc &crtc) {
+  int count = 0;
+  for (const auto &plane : dev.GetPlanes()) {
+    if (plane->IsCrtcSupported(crtc))
+      ++count;
+  }
+  return count;
+}
+
 static auto TryCreatePipelineUsingEncoder(DrmDevice &dev, DrmConnector &conn,
                                           DrmEncoder &enc)
     -> std::unique_ptr<DrmDisplayPipeline> {
+  /* The panel is wired to both VOPs. The little one is bound first and cannot
+   * scan AFBC, so an AFBC framebuffer commit fails with EINVAL and the panel
+   * stays black. Pick the CRTC with the most planes for DSI. */
+  if (Properties::PreferWideCrtc() &&
+      conn.GetName().find("DSI") != std::string::npos) {
+    DrmCrtc *best = nullptr;
+    int best_planes = -1;
+    for (const auto &crtc : dev.GetCrtcs()) {
+      if (!enc.SupportsCrtc(*crtc))
+        continue;
+      int planes = CountPlanesForCrtc(dev, *crtc);
+      if (planes > best_planes) {
+        best = crtc.get();
+        best_planes = planes;
+      }
+    }
+    if (best != nullptr) {
+      ALOGI("Preferring CRTC %d (%d planes) for %s", best->GetId(), best_planes,
+            conn.GetName().c_str());
+      auto pipeline = TryCreatePipeline(dev, conn, enc, *best);
+      if (pipeline)
+        return pipeline;
+    }
+  }
+
   /* First try to use the currently-bound crtc */
   auto *crtc = dev.FindCrtcById(enc.GetCurrentCrtcId());
   if (crtc != nullptr) {
