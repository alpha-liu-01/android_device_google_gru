diff --git a/src/android/camera_device.cpp b/src/android/camera_device.cpp
index d45bd4e..fd91063 100644
--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -349,6 +349,37 @@ bool isJpegStream(camera3_stream_t *stream)
 	}
 
 	sortCamera3StreamConfigs(streamConfigs, jpegStream);
+
+	/*
+	 * rkisp1 supports at most 2 hardware output streams (mainpath and
+	 * selfpath). If more than 2 StreamConfigurations were created (e.g.
+	 * 2 YUV streams of different sizes plus 1 JPEG stream), attach the
+	 * smaller YUV stream(s) as Mapped streams onto the larger Direct YUV
+	 * stream so PostProcessorYuv scales them down via libyuv.
+	 */
+	if (streamConfigs.size() > 2) {
+		int directIdx = -1;
+		for (size_t i = 0; i < 2; ++i) {
+			if (!streamConfigs[i].streams.empty() &&
+			    streamConfigs[i].streams[0].type == CameraStream::Type::Direct) {
+				directIdx = i;
+				break;
+			}
+		}
+		if (directIdx >= 0) {
+			streamConfigs[directIdx].streams[0].stream->usage |=
+				GRALLOC_USAGE_SW_READ_OFTEN;
+			for (size_t i = 2; i < streamConfigs.size(); ++i) {
+				for (auto &s : streamConfigs[i].streams) {
+					s.stream->usage |= GRALLOC_USAGE_SW_WRITE_OFTEN;
+					streamConfigs[directIdx].streams.push_back(
+						{ s.stream, CameraStream::Type::Mapped });
+				}
+			}
+			streamConfigs.resize(2);
+		}
+	}
+
 	return 0;
 }
 
