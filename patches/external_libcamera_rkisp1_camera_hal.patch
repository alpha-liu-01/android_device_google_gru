+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board
+ *
+ * goc.cpp - RkISP1 Gamma Out Correction control
+ */
+
+#include "goc.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "linux/rkisp1-config.h"
+
+namespace libcamera {
+
+namespace ipa::rkisp1::algorithms {
+
+LOG_DEFINE_CATEGORY(RkISP1Goc)
+
+static constexpr uint16_t kDefaultGammaCurveV10[RKISP1_CIF_ISP_GAMMA_OUT_MAX_SAMPLES_V10] = {
+	0, 73, 137, 183, 223, 287, 340, 387, 429, 502, 565, 623, 723, 810, 888, 959, 1023
+};
+
+int GammaOutCorrection::init([[maybe_unused]] IPAContext &context,
+			     const YamlObject &tuningData)
+{
+	gammaCurve_ = tuningData["gamma-curve"].getList<uint16_t>().value_or(
+		std::vector<uint16_t>(std::begin(kDefaultGammaCurveV10),
+				      std::end(kDefaultGammaCurveV10)));
+
+	if (gammaCurve_.size() != RKISP1_CIF_ISP_GAMMA_OUT_MAX_SAMPLES_V10) {
+		LOG(RkISP1Goc, Warning)
+			<< "Invalid 'gamma-curve' size " << gammaCurve_.size()
+			<< ", using default V10 gamma curve";
+		gammaCurve_.assign(std::begin(kDefaultGammaCurveV10),
+				   std::end(kDefaultGammaCurveV10));
+	}
+
+	return 0;
+}
+
+void GammaOutCorrection::prepare([[maybe_unused]] IPAContext &context,
+				 const uint32_t frame,
+				 [[maybe_unused]] IPAFrameContext &frameContext,
+				 rkisp1_params_cfg *params)
+{
+	if (frame > 0)
+		return;
+
+	params->others.goc_config.mode = RKISP1_CIF_ISP_GOC_MODE_LOGARITHMIC;
+	std::copy(gammaCurve_.begin(), gammaCurve_.end(),
+		  params->others.goc_config.gamma_y);
+
+	params->module_en_update |= RKISP1_CIF_ISP_MODULE_GOC;
+	params->module_ens |= RKISP1_CIF_ISP_MODULE_GOC;
+	params->module_cfg_update |= RKISP1_CIF_ISP_MODULE_GOC;
+}
+
+REGISTER_IPA_ALGORITHM(GammaOutCorrection, "GammaOutCorrection")
+
+} /* namespace ipa::rkisp1::algorithms */
+} /* namespace libcamera */
