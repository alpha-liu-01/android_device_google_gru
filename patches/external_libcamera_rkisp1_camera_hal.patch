+void PipelineHandlerRkISP1::notifyShutterUpTo(RkISP1FrameInfo *targetInfo,
+					      uint64_t timestamp)
+{
+	RkISP1CameraData *data = cameraData(activeCamera_);
+
+	for (auto &[frame, info] : data->frameInfo_.map()) {
+		if (frame > targetInfo->frame)
+			break;
+		if (info->shutterNotified)
+			continue;
+
+		if (timestamp <= data->lastTimestamp_)
+			timestamp = data->lastTimestamp_ + 1000;
+		data->lastTimestamp_ = timestamp;
+
+		info->shutterNotified = true;
+
+		ControlList timestampMetadata(controls::controls);
+		timestampMetadata.set(controls::SensorTimestamp,
+				      static_cast<int64_t>(timestamp));
+		metadataAvailable(info->request, timestampMetadata);
+	}
+}
