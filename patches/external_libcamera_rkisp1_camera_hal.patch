@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2024, Ideas On Board
+ *
+ * ccm.cpp - RkISP1 Cross Talk / Color Correction Matrix control
+ */
+
+#include "ccm.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "linux/rkisp1-config.h"
+
+namespace libcamera {
+
+namespace ipa::rkisp1::algorithms {
+
+LOG_DEFINE_CATEGORY(RkISP1Ccm)
+
+Ccm::Ccm()
+	: ct_(0)
+{
+}
+
+int Ccm::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	const YamlObject &yamlCcms = tuningData["ccms"];
+	if (!yamlCcms.isList()) {
+		LOG(RkISP1Ccm, Error) << "'ccms' list not found in tuning file";
+		return -EINVAL;
+	}
+
+	for (const auto &entry : yamlCcms.asList()) {
+		uint32_t ct = entry["ct"].get<uint32_t>(0);
+		std::vector<double> ccm =
+			entry["ccm"].getList<double>().value_or(std::vector<double>{});
+		if (ct == 0 || ccm.size() != 9) {
+			LOG(RkISP1Ccm, Error)
+				<< "Invalid CCM entry for ct " << ct;
+			return -EINVAL;
+		}
+
+		CcmEntry item{};
+		item.ct = ct;
+		std::copy_n(ccm.begin(), 9, item.ccm.begin());
+		item.offsets = { 0, 0, 0 };
+
+		std::vector<int16_t> offsets =
+			entry["offsets"].getList<int16_t>().value_or(std::vector<int16_t>{});
+		if (offsets.size() == 3)
+			std::copy_n(offsets.begin(), 3, item.offsets.begin());
+
+		ccms_.push_back(item);
+	}
+
+	if (ccms_.empty()) {
+		LOG(RkISP1Ccm, Error) << "No CCM entries loaded";
+		return -EINVAL;
+	}
+
+	std::sort(ccms_.begin(), ccms_.end(),
+		  [](const CcmEntry &a, const CcmEntry &b) {
+			  return a.ct < b.ct;
+		  });
+
+	return 0;
+}
+
+int Ccm::configure([[maybe_unused]] IPAContext &context,
+		   [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	ct_ = 0;
+	return 0;
+}
+
+void Ccm::prepare(IPAContext &context, const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  rkisp1_params_cfg *params)
+{
+	if (ccms_.empty())
+		return;
+
+	uint32_t ct = context.activeState.awb.temperatureK;
+	if (ct == 0)
+		ct = 5000;
+
+	if (frame > 0 &&
+	    std::abs(static_cast<int>(ct) - static_cast<int>(ct_)) < 100)
+		return;
+
+	ct_ = ct;
+
+	std::array<double, 9> ccm{};
+	std::array<int16_t, 3> offsets{};
+
+	if (ct <= ccms_.front().ct) {
+		ccm = ccms_.front().ccm;
+		offsets = ccms_.front().offsets;
+	} else if (ct >= ccms_.back().ct) {
+		ccm = ccms_.back().ccm;
+		offsets = ccms_.back().offsets;
+	} else {
+		for (size_t i = 0; i + 1 < ccms_.size(); ++i) {
+			if (ct >= ccms_[i].ct && ct <= ccms_[i + 1].ct) {
+				double span = static_cast<double>(ccms_[i + 1].ct - ccms_[i].ct);
+				double w1 = (span > 0.0) ? ((ct - ccms_[i].ct) / span) : 0.0;
+				double w0 = 1.0 - w1;
+				for (size_t k = 0; k < 9; ++k)
+					ccm[k] = ccms_[i].ccm[k] * w0 + ccms_[i + 1].ccm[k] * w1;
+				for (size_t k = 0; k < 3; ++k)
+					offsets[k] = std::lround(ccms_[i].offsets[k] * w0 +
+								 ccms_[i + 1].offsets[k] * w1);
+				break;
+			}
+		}
+	}
+
+	for (unsigned int i = 0; i < 3; ++i) {
+		for (unsigned int j = 0; j < 3; ++j) {
+			double v = ccm[i * 3 + j];
+			int coeff = std::clamp<int>(std::lround(v * 128.0), -1024, 1023);
+			params->others.ctk_config.coeff[i][j] =
+				static_cast<uint16_t>(coeff) & 0x7ff;
+		}
+		params->others.ctk_config.ct_offset[i] =
+			static_cast<uint16_t>(offsets[i]) & 0xfff;
+	}
+
+	params->module_en_update |= RKISP1_CIF_ISP_MODULE_CTK;
+	params->module_ens |= RKISP1_CIF_ISP_MODULE_CTK;
+	params->module_cfg_update |= RKISP1_CIF_ISP_MODULE_CTK;
+}
+
+REGISTER_IPA_ALGORITHM(Ccm, "Ccm")
+
+} /* namespace ipa::rkisp1::algorithms */
+} /* namespace libcamera */
