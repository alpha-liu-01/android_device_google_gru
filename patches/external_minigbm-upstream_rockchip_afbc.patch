 #ifndef DRV_ROCKCHIP
-INIT_DUMB_DRIVER(rockchip)
+/*
+ * Mali-T860 and the RK3399 big VOP both take
+ * DRM_FORMAT_MOD_ARM_AFBC(16x16 | SPARSE | YTR). Android allocates with
+ * drv_bo_create() and no modifier list, so the choice is made here. The
+ * dumb ioctl only provides a byte range; the modifier is metadata. The
+ * size matches drm_gem_afbc_min_size() (64-byte header alignment, 16x16
+ * sparse body). MINIGBM_DEBUG=nocompression keeps every buffer linear.
+ */
+#define ROCKCHIP_AFBC_MOD                                                                          \
+	DRM_FORMAT_MOD_ARM_AFBC(AFBC_FORMAT_MOD_BLOCK_SIZE_16x16 | AFBC_FORMAT_MOD_SPARSE |        \
+				AFBC_FORMAT_MOD_YTR)
+
+static bool rockchip_afbc_ok(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+			     uint64_t use_flags)
+{
+	const uint64_t blocked =
+	    BO_USE_LINEAR | BO_USE_SW_READ_OFTEN | BO_USE_SW_READ_RARELY | BO_USE_SW_WRITE_OFTEN |
+	    BO_USE_SW_WRITE_RARELY | BO_USE_CAMERA_READ | BO_USE_CAMERA_WRITE | BO_USE_PROTECTED |
+	    BO_USE_HW_VIDEO_DECODER | BO_USE_HW_VIDEO_ENCODER | BO_USE_CURSOR | BO_USE_RENDERSCRIPT |
+	    BO_USE_GPU_DATA_BUFFER | BO_USE_SENSOR_DIRECT_DATA | BO_USE_FRONT_RENDERING;
+
+	if (!bo->drv->compression)
+		return false;
+	if (use_flags & blocked)
+		return false;
+	if (!(use_flags & (BO_USE_RENDERING | BO_USE_SCANOUT)))
+		return false;
+	/* Unaligned sizes would change the reported pixel stride. */
+	if (!IS_ALIGNED(width, 16) || !IS_ALIGNED(height, 16))
+		return false;
+	if (width > 2560 || height > 2560)
+		return false;
+
+	switch (format) {
+	case DRM_FORMAT_ABGR8888:
+	case DRM_FORMAT_ARGB8888:
+	case DRM_FORMAT_XBGR8888:
+	case DRM_FORMAT_XRGB8888:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* Header is 16 bytes per 16x16 block, aligned to 64. Each body block is 1024 bytes. */
+static uint64_t rockchip_afbc_bytes(uint32_t width, uint32_t height)
+{
+	uint32_t n_blocks = (width / 16) * (height / 16);
+	uint32_t header = ALIGN(n_blocks * 16, 64);
+	uint32_t body_block = ALIGN(4 * 256, 128);
+
+	return (uint64_t)header + (uint64_t)n_blocks * body_block;
+}
+
+static int rockchip_dumb_bo_create(struct bo *bo, uint32_t width, uint32_t height, uint32_t format,
+				   uint64_t use_flags)
+{
+	struct drm_mode_create_dumb create_dumb = { 0 };
+	uint64_t needed;
+	int ret;
+	static bool logged;
+
+	if (!rockchip_afbc_ok(bo, width, height, format, use_flags))
+		return drv_dumb_bo_create(bo, width, height, format, use_flags);
+
+	needed = ALIGN(rockchip_afbc_bytes(width, height), 4096);
+	/*
+	 * rockchip_gem_dumb_create forces pitch = ALIGN(width * bpp / 8, 64).
+	 * width 64 and bpp 8 make pitch 64, so height selects the byte size.
+	 */
+	create_dumb.bpp = 8;
+	create_dumb.width = 64;
+	create_dumb.height = (uint32_t)(needed / 64);
+
+	ret = drmIoctl(bo->drv->fd, DRM_IOCTL_MODE_CREATE_DUMB, &create_dumb);
+	if (ret || create_dumb.size < needed) {
+		if (!ret) {
+			struct drm_mode_destroy_dumb destroy_dumb = { 0 };
+
+			destroy_dumb.handle = create_dumb.handle;
+			drmIoctl(bo->drv->fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy_dumb);
+		}
+		return drv_dumb_bo_create(bo, width, height, format, use_flags);
+	}
+
+	bo->handle.u32 = create_dumb.handle;
+	/* Same stride minigbm's AFBC layout reports: one linear row of the aligned image. */
+	bo->meta.strides[0] = width * 4;
+	bo->meta.sizes[0] = create_dumb.size;
+	bo->meta.offsets[0] = 0;
+	bo->meta.total_size = create_dumb.size;
+	bo->meta.format_modifier = ROCKCHIP_AFBC_MOD;
+
+	if (!logged) {
+		logged = true;
+		drv_logi("rockchip AFBC 16x16 sparse YTR, %ux%u\n", width, height);
+	}
+	return 0;
+}
+
+static void *rockchip_dumb_bo_map(struct bo *bo, struct vma *vma, uint32_t map_flags)
+{
+	if (bo->meta.format_modifier == ROCKCHIP_AFBC_MOD)
+		return MAP_FAILED;
+	return drv_dumb_bo_map(bo, vma, map_flags);
+}
+
+const struct backend backend_rockchip = {
+	/* drv_get_backend() only name-matches backends that are not generic.
+	 * Leaving this set made every card0 allocation fall through to
+	 * dumb_generic, which is linear-only. */
+	.is_generic_backend = false,
+	.name = "rockchip",
+	.init = dumb_driver_init,
+	.bo_create = rockchip_dumb_bo_create,
+	.bo_create_with_modifiers = dumb_bo_create_with_modifiers,
+	.bo_destroy = drv_dumb_bo_destroy,
+	.bo_import = drv_prime_bo_import,
+	.bo_export = drv_prime_bo_export,
+	.bo_map = rockchip_dumb_bo_map,
+	.bo_unmap = drv_bo_munmap,
+	.resolve_format_and_use_flags = drv_resolve_format_and_use_flags_helper,
+};
 #endif
 #ifndef DRV_MEDIATEK
 INIT_DUMB_DRIVER(mediatek)
