+#include <ui/Size.h>
+
+#include <v4l2_codec2/common/VideoTypes.h>
+#include <v4l2_codec2/components/VideoDecoder.h>
+#include <v4l2_codec2/components/VideoFrame.h>
+#include <v4l2_codec2/components/VideoFramePool.h>
+
+namespace android {
+
+// VideoDecoder for V4L2 stateless (request API) devices such as rkvdec and hantro. Bitstream
+// parsing and request submission are done by cros-codecs, which decodes directly into the
+// C2GraphicBlocks of the output pool (DMABUF import, no copy).
+// All methods must be called on |taskRunner|.
+class StatelessV4L2Decoder : public VideoDecoder {
+public:
+    static std::unique_ptr<VideoDecoder> Create(
+            uint32_t debugStreamId, VideoCodec codec, size_t minNumOutputBuffers,
+            GetPoolCB getPoolCb, OutputCB outputCb, ErrorCB errorCb,
+            scoped_refptr<::base::SequencedTaskRunner> taskRunner);
+    ~StatelessV4L2Decoder() override;
+
+    void decode(std::unique_ptr<ConstBitstreamBuffer> buffer, DecodeCB decodeCb) override;
+    void drain(DecodeCB drainCb) override;
+    void flush() override;
+
+private:
+    // A pending decode request, or a drain request if |buffer| is null.
+    struct DecodeRequest {
+        std::unique_ptr<ConstBitstreamBuffer> buffer;
+        DecodeCB decodeCb;
+        std::optional<C2ReadView> view;
+        size_t offset = 0;
+    };
+
+    // An output buffer referenced by cros-codecs. |frame| is null once it has been output.
+    struct FrameAtDecoder {
+        std::unique_ptr<VideoFrame> frame;
+        uint32_t blockId;
+        uint64_t poolGeneration;
+    };
+
+    struct PlaneLayouts {
+        uint32_t numPlanes = 0;
+        uint64_t offsets[CC_MAX_PLANES] = {};
+        uint64_t strides[CC_MAX_PLANES] = {};
+    };
+
+    StatelessV4L2Decoder(uint32_t debugStreamId, size_t minNumOutputBuffers, GetPoolCB getPoolCb,
+                         OutputCB outputCb, ErrorCB errorCb,
+                         scoped_refptr<::base::SequencedTaskRunner> taskRunner);
+    bool initialize(VideoCodec codec);
+
+    void schedulePump();
+    void pumpDecodeRequests();
+    // Handles all pending decoder events. Returns the number of events, or -1 on error.
+    int processEvents();
+    bool onFormatChanged(const CcEvent& event);
+    void onFrameReady(const CcEvent& event);
+
+    void tryFetchVideoFrame();
+    void onVideoFrameReady(uint64_t poolGeneration,
+                           std::optional<VideoFramePool::FrameWithBlockId> frameWithBlockId);
+    std::optional<PlaneLayouts> queryPlaneLayouts(const VideoFrame& frame) const;
+
+    // Called by cros-codecs, synchronously from inside the FFI calls.
+    bool allocFrame(CcFrameDesc* desc);
+    void releaseFrame(uint64_t token);
+    static bool AllocFrameThunk(void* ctx, CcFrameDesc* desc);
+    static void ReleaseFrameThunk(void* ctx, uint64_t token);
+
+    void onError();
+    void notifyError();
+
+    const uint32_t mDebugStreamId;
+    const size_t mMinNumOutputBuffers;
+    GetPoolCB mGetPoolCb;
+    OutputCB mOutputCb;
+    ErrorCB mErrorCb;
+    scoped_refptr<::base::SequencedTaskRunner> mTaskRunner;
+
+    ::CrosCodecsDecoder* mFfiDecoder = nullptr;
+
+    std::queue<DecodeRequest> mDecodeRequests;
+    bool mPumpScheduled = false;
+    // Number of available frames the pump waits for before retrying, 0 when not waiting. A single
+    // call may need several frames (e.g. the hidden and shown frames of a VP9 superframe), and
+    // cros-codecs gives back the frames it got when it runs short.
+    size_t mNumFramesNeeded = 0;
+    bool mDiscardOutput = false;
+    bool mError = false;
+
+    std::unique_ptr<VideoFramePool> mVideoFramePool;
+    uint64_t mPoolGeneration = 0;
+    bool mFetchPending = false;
+    ui::Size mCodedSize;
+    Rect mVisibleRect;
+    std::optional<PlaneLayouts> mPlaneLayouts;
+
+    // Frames fetched from the pool, ready to be handed to cros-codecs.
+    std::deque<VideoFramePool::FrameWithBlockId> mAvailableFrames;
+    // Frames the pool handed out again while cros-codecs still references their buffer, e.g. as a
+    // reference frame after the client returned the displayed block. Keyed by block ID.
+    std::map<uint32_t, std::unique_ptr<VideoFrame>> mDeferredFrames;
+    // Frames referenced by cros-codecs, keyed by token.
+    std::map<uint64_t, FrameAtDecoder> mFramesAtDecoder;
+    // Block IDs of the current pool referenced by cros-codecs, mapped to their token.
+    std::map<uint32_t, uint64_t> mBlockIdToToken;
+    uint64_t mNextToken = 1;
+
+    ::base::WeakPtr<StatelessV4L2Decoder> mWeakThis;
+    ::base::WeakPtrFactory<StatelessV4L2Decoder> mWeakThisFactory{this};
+};
+
+}  // namespace android
+
+#endif  // ANDROID_V4L2_CODEC2_V4L2_STATELESS_V4L2_DECODER_H
