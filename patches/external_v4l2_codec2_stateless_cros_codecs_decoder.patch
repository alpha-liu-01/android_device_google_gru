@@ -0,0 +1,557 @@
+// Copyright 2026 The LineageOS Project
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//#define LOG_NDEBUG 0
+#define ATRACE_TAG ATRACE_TAG_VIDEO
+#define LOG_TAG "StatelessV4L2Decoder"
+
+#include <v4l2_codec2/v4l2/StatelessV4L2Decoder.h>
+
+#include <inttypes.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <vector>
+
+#include <C2AllocatorGralloc.h>
+#include <base/bind.h>
+#include <base/memory/ptr_util.h>
+#include <linux/videodev2.h>
+#include <log/log.h>
+#include <ui/GraphicBuffer.h>
+#include <ui/GraphicBufferMapper.h>
+#include <utils/Trace.h>
+
+namespace android {
+namespace {
+
+// Number of output buffers on top of the decoder's own requirement (DPB plus the CAPTURE slots
+// cros-codecs keeps in flight): the frames held by the client and the component.
+constexpr size_t kNumExtraOutputBuffers = 7;
+// Number of free frames to keep fetched from the pool ahead of time.
+constexpr size_t kNumPrefetchedFrames = 2;
+// Number of consecutive cros-codecs calls without progress before giving up.
+constexpr int kMaxCallsWithoutProgress = 16;
+
+uint32_t toCcCodec(VideoCodec codec, bool* ok) {
+    *ok = true;
+    switch (codec) {
+    case VideoCodec::H264:
+        return CC_CODEC_H264;
+    case VideoCodec::VP8:
+        return CC_CODEC_VP8;
+    case VideoCodec::VP9:
+        return CC_CODEC_VP9;
+    default:
+        *ok = false;
+        return 0;
+    }
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<VideoDecoder> StatelessV4L2Decoder::Create(
+        uint32_t debugStreamId, VideoCodec codec, size_t minNumOutputBuffers, GetPoolCB getPoolCb,
+        OutputCB outputCb, ErrorCB errorCb,
+        scoped_refptr<::base::SequencedTaskRunner> taskRunner) {
+    std::unique_ptr<StatelessV4L2Decoder> decoder = ::base::WrapUnique<StatelessV4L2Decoder>(
+            new StatelessV4L2Decoder(debugStreamId, minNumOutputBuffers, std::move(getPoolCb),
+                                     std::move(outputCb), std::move(errorCb),
+                                     std::move(taskRunner)));
+    if (!decoder->initialize(codec)) {
+        return nullptr;
+    }
+    return decoder;
+}
+
+StatelessV4L2Decoder::StatelessV4L2Decoder(uint32_t debugStreamId, size_t minNumOutputBuffers,
+                                           GetPoolCB getPoolCb, OutputCB outputCb,
+                                           ErrorCB errorCb,
+                                           scoped_refptr<::base::SequencedTaskRunner> taskRunner)
+      : mDebugStreamId(debugStreamId),
+        mMinNumOutputBuffers(minNumOutputBuffers),
+        mGetPoolCb(std::move(getPoolCb)),
+        mOutputCb(std::move(outputCb)),
+        mErrorCb(std::move(errorCb)),
+        mTaskRunner(std::move(taskRunner)) {
+    ALOGV("%s()", __func__);
+    mWeakThis = mWeakThisFactory.GetWeakPtr();
+}
+
+StatelessV4L2Decoder::~StatelessV4L2Decoder() {
+    ALOGV("%s()", __func__);
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    mWeakThisFactory.InvalidateWeakPtrs();
+
+    // Destroying the decoder fires the release callbacks of all frames it still references.
+    if (mFfiDecoder) {
+        cros_codecs_decoder_destroy(mFfiDecoder);
+        mFfiDecoder = nullptr;
+    }
+    mFramesAtDecoder.clear();
+    mDeferredFrames.clear();
+    mAvailableFrames.clear();
+    mVideoFramePool.reset();
+}
+
+bool StatelessV4L2Decoder::initialize(VideoCodec codec) {
+    ALOGV("%s(codec=%s)", __func__, VideoCodecToString(codec));
+
+    bool ok;
+    const uint32_t ccCodec = toCcCodec(codec, &ok);
+    if (!ok) {
+        ALOGE("Codec %s is not supported by cros-codecs", VideoCodecToString(codec));
+        return false;
+    }
+
+    mFfiDecoder = cros_codecs_decoder_create(ccCodec, this, &StatelessV4L2Decoder::AllocFrameThunk,
+                                             &StatelessV4L2Decoder::ReleaseFrameThunk);
+    if (!mFfiDecoder) {
+        ALOGE("Failed to create cros-codecs %s decoder", VideoCodecToString(codec));
+        return false;
+    }
+    ALOGI("Created cros-codecs %s decoder (stream %u)", VideoCodecToString(codec), mDebugStreamId);
+    return true;
+}
+
+void StatelessV4L2Decoder::decode(std::unique_ptr<ConstBitstreamBuffer> buffer,
+                                  DecodeCB decodeCb) {
+    ATRACE_CALL();
+    ALOGV("%s(id=%d)", __func__, buffer->id);
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    if (mError) {
+        std::move(decodeCb).Run(DecodeStatus::kError);
+        return;
+    }
+
+    DecodeRequest request;
+    request.buffer = std::move(buffer);
+    request.decodeCb = std::move(decodeCb);
+    mDecodeRequests.push(std::move(request));
+    schedulePump();
+}
+
+void StatelessV4L2Decoder::drain(DecodeCB drainCb) {
+    ATRACE_CALL();
+    ALOGV("%s()", __func__);
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    if (mError) {
+        std::move(drainCb).Run(DecodeStatus::kError);
+        return;
+    }
+
+    DecodeRequest request;
+    request.decodeCb = std::move(drainCb);
+    mDecodeRequests.push(std::move(request));
+    schedulePump();
+}
+
+void StatelessV4L2Decoder::flush() {
+    ATRACE_CALL();
+    ALOGV("%s()", __func__);
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    while (!mDecodeRequests.empty()) {
+        DecodeCB decodeCb = std::move(mDecodeRequests.front().decodeCb);
+        mDecodeRequests.pop();
+        std::move(decodeCb).Run(DecodeStatus::kAborted);
+    }
+    mNumFramesNeeded = 0;
+
+    if (mError) {
+        return;
+    }
+
+    // Frames still pending in the DPB belong to the abandoned works and are dropped.
+    mDiscardOutput = true;
+    if (cros_codecs_decoder_flush(mFfiDecoder) != CC_STATUS_OK) {
+        ALOGE("Failed to flush cros-codecs decoder");
+        onError();
+    } else {
+        processEvents();
+    }
+    mDiscardOutput = false;
+}
+
+void StatelessV4L2Decoder::schedulePump() {
+    if (mPumpScheduled) {
+        return;
+    }
+    mPumpScheduled = true;
+    mTaskRunner->PostTask(FROM_HERE, ::base::BindOnce(&StatelessV4L2Decoder::pumpDecodeRequests,
+                                                      mWeakThis));
+}
+
+void StatelessV4L2Decoder::pumpDecodeRequests() {
+    ATRACE_CALL();
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    mPumpScheduled = false;
+    mNumFramesNeeded = 0;
+
+    while (!mDecodeRequests.empty() && !mError) {
+        DecodeRequest& request = mDecodeRequests.front();
+
+        if (!request.buffer) {
+            ALOGV("Draining");
+            if (cros_codecs_decoder_flush(mFfiDecoder) != CC_STATUS_OK) {
+                ALOGE("Failed to drain cros-codecs decoder");
+                onError();
+                return;
+            }
+            if (processEvents() < 0) {
+                return;
+            }
+            DecodeCB drainCb = std::move(request.decodeCb);
+            mDecodeRequests.pop();
+            std::move(drainCb).Run(DecodeStatus::kOk);
+            continue;
+        }
+
+        if (!request.view) {
+            request.view.emplace(request.buffer->dmabuf.map().get());
+            if (request.view->error() != C2_OK) {
+                ALOGE("Failed to map bitstream buffer %d: %d", request.buffer->id,
+                      request.view->error());
+                onError();
+                return;
+            }
+        }
+
+        const int32_t bitstreamId = request.buffer->id;
+        const uint8_t* data = request.view->data();
+        const size_t size = std::min<size_t>(request.buffer->size, request.view->capacity());
+        int callsWithoutProgress = 0;
+        while (request.offset < size) {
+            size_t consumed = 0;
+            const int32_t status =
+                    cros_codecs_decoder_decode(mFfiDecoder, static_cast<uint64_t>(bitstreamId),
+                                               data, size, request.offset, false, &consumed);
+            const int numEvents = processEvents();
+            if (numEvents < 0 || mError) {
+                return;
+            }
+
+            if (status == CC_STATUS_OK) {
+                callsWithoutProgress = 0;
+                request.offset = consumed > 0 ? request.offset + consumed : size;
+                continue;
+            }
+            if (status == CC_STATUS_NEED_FRAMES) {
+                mNumFramesNeeded = mAvailableFrames.size() + 1;
+                ALOGV("Waiting for %zu output frames (bitstream %d)", mNumFramesNeeded,
+                      bitstreamId);
+                tryFetchVideoFrame();
+                return;
+            }
+            if (status == CC_STATUS_ERROR) {
+                ALOGE("Failed to decode bitstream %d", bitstreamId);
+                onError();
+                return;
+            }
+            // CHECK_EVENTS or OUT_OF_SLOTS: retry as long as the decoder makes progress.
+            if (numEvents == 0 && ++callsWithoutProgress > kMaxCallsWithoutProgress) {
+                ALOGE("Decoder stuck on bitstream %d (status %d)", bitstreamId, status);
+                onError();
+                return;
+            }
+        }
+
+        DecodeCB decodeCb = std::move(request.decodeCb);
+        mDecodeRequests.pop();
+        std::move(decodeCb).Run(DecodeStatus::kOk);
+    }
+}
+
+int StatelessV4L2Decoder::processEvents() {
+    int numEvents = 0;
+    CcEvent event;
+    while (!mError && cros_codecs_decoder_next_event(mFfiDecoder, &event)) {
+        ++numEvents;
+        switch (event.type) {
+        case CC_EVENT_FRAME:
+            onFrameReady(event);
+            break;
+        case CC_EVENT_FORMAT_CHANGED:
+            if (!onFormatChanged(event)) {
+                onError();
+            }
+            break;
+        case CC_EVENT_CSD:
+            break;
+        default:
+            ALOGW("Unknown cros-codecs event %u", event.type);
+            break;
+        }
+    }
+    return mError ? -1 : numEvents;
+}
+
+bool StatelessV4L2Decoder::onFormatChanged(const CcEvent& event) {
+    ALOGI("Format changed: coded %ux%u, visible (%u,%u)-(%u,%u), %u min frames, fourcc %08x",
+          event.coded_width, event.coded_height, event.visible_left, event.visible_top,
+          event.visible_right, event.visible_bottom, event.min_num_frames, event.fourcc);
+
+    if (event.fourcc != V4L2_PIX_FMT_NV12) {
+        ALOGE("Unsupported output fourcc %08x", event.fourcc);
+        return false;
+    }
+    if (event.coded_width == 0 || event.coded_height == 0) {
+        ALOGE("Invalid coded size %ux%u", event.coded_width, event.coded_height);
+        return false;
+    }
+
+    mCodedSize = ui::Size(event.coded_width, event.coded_height);
+    mVisibleRect = Rect(event.visible_left, event.visible_top, event.visible_right,
+                        event.visible_bottom);
+    if (mVisibleRect.isEmpty()) {
+        mVisibleRect = Rect(mCodedSize.width, mCodedSize.height);
+    }
+
+    // Frames of the previous pool still referenced by cros-codecs are dropped on release.
+    mPoolGeneration++;
+    mFetchPending = false;
+    mAvailableFrames.clear();
+    mDeferredFrames.clear();
+    mBlockIdToToken.clear();
+    mPlaneLayouts.reset();
+
+    // Release the old pool first, so the old and new buffers never exist at the same time.
+    mVideoFramePool.reset();
+    const size_t numOutputBuffers =
+            std::max(mMinNumOutputBuffers, event.min_num_frames + kNumExtraOutputBuffers);
+    mVideoFramePool = mGetPoolCb.Run(mCodedSize, HalPixelFormat::YCBCR_420_888, numOutputBuffers);
+    if (!mVideoFramePool) {
+        ALOGE("Failed to get video frame pool of size %dx%d", mCodedSize.width,
+              mCodedSize.height);
+        return false;
+    }
+
+    tryFetchVideoFrame();
+    return true;
+}
+
+void StatelessV4L2Decoder::onFrameReady(const CcEvent& event) {
+    ALOGV("%s(bitstreamId=%" PRIu64 ", token=%" PRIu64 ")", __func__, event.timestamp,
+          event.token);
+
+    auto it = mFramesAtDecoder.find(event.token);
+    if (it == mFramesAtDecoder.end()) {
+        ALOGE("Decoder returned unknown frame %" PRIu64, event.token);
+        onError();
+        return;
+    }
+    if (mDiscardOutput) {
+        return;
+    }
+    if (!it->second.frame) {
+        // VP9 show_existing_frame of a frame that was already output. DecodeComponent treats the
+        // corresponding work as a no-show frame.
+        ALOGW("Frame %" PRIu64 " was already output, dropping bitstream %" PRIu64, event.token,
+              event.timestamp);
+        return;
+    }
+
+    std::unique_ptr<VideoFrame> frame = std::move(it->second.frame);
+    Rect visibleRect(event.visible_left, event.visible_top, event.visible_right,
+                     event.visible_bottom);
+    frame->setVisibleRect(visibleRect.isEmpty() ? mVisibleRect : visibleRect);
+    frame->setBitstreamId(static_cast<int32_t>(event.timestamp));
+    mOutputCb.Run(std::move(frame));
+}
+
+void StatelessV4L2Decoder::tryFetchVideoFrame() {
+    if (!mVideoFramePool || mFetchPending || mError) {
+        return;
+    }
+    if (mAvailableFrames.size() >= std::max(kNumPrefetchedFrames, mNumFramesNeeded)) {
+        return;
+    }
+    mFetchPending = mVideoFramePool->getVideoFrame(::base::BindOnce(
+            &StatelessV4L2Decoder::onVideoFrameReady, mWeakThis, mPoolGeneration));
+}
+
+void StatelessV4L2Decoder::onVideoFrameReady(
+        uint64_t poolGeneration, std::optional<VideoFramePool::FrameWithBlockId> frameWithBlockId) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    if (poolGeneration != mPoolGeneration) {
+        return;
+    }
+    mFetchPending = false;
+    if (!frameWithBlockId || !frameWithBlockId->first) {
+        ALOGE("Failed to get a video frame from the pool");
+        onError();
+        return;
+    }
+
+    const uint32_t blockId = frameWithBlockId->second;
+    ALOGV("%s(blockId=%u)", __func__, blockId);
+    if (mBlockIdToToken.find(blockId) != mBlockIdToToken.end()) {
+        mDeferredFrames[blockId] = std::move(frameWithBlockId->first);
+    } else {
+        mAvailableFrames.push_back(std::move(*frameWithBlockId));
+    }
+
+    if (mNumFramesNeeded > 0 && mAvailableFrames.size() >= mNumFramesNeeded) {
+        schedulePump();
+    }
+    tryFetchVideoFrame();
+}
+
+std::optional<StatelessV4L2Decoder::PlaneLayouts> StatelessV4L2Decoder::queryPlaneLayouts(
+        const VideoFrame& frame) const {
+    PlaneLayouts layouts;
+
+    native_handle_t* grallocHandle = UnwrapNativeCodec2GrallocHandle(frame.getHandle());
+    if (grallocHandle) {
+        uint32_t width, height, format, stride, generation, igbpSlot;
+        uint64_t usage, igbpId;
+        _UnwrapNativeCodec2GrallocMetadata(frame.getHandle(), &width, &height, &format, &usage,
+                                           &stride, &generation, &igbpId, &igbpSlot);
+        sp<GraphicBuffer> buffer = new GraphicBuffer(grallocHandle, GraphicBuffer::CLONE_HANDLE,
+                                                     width, height, format, 1, usage, stride);
+        native_handle_delete(grallocHandle);
+
+        std::vector<ui::PlaneLayout> planeLayouts;
+        if (buffer->initCheck() == OK &&
+            GraphicBufferMapper::get().getPlaneLayouts(buffer->handle, &planeLayouts) == OK &&
+            planeLayouts.size() == 2) {
+            layouts.numPlanes = 2;
+            for (size_t i = 0; i < 2; ++i) {
+                layouts.offsets[i] = planeLayouts[i].offsetInBytes;
+                layouts.strides[i] = planeLayouts[i].strideInBytes;
+            }
+            ALOGI("Output buffer layout: Y offset %" PRIu64 " stride %" PRIu64
+                  ", UV offset %" PRIu64 " stride %" PRIu64,
+                  layouts.offsets[0], layouts.strides[0], layouts.offsets[1], layouts.strides[1]);
+            return layouts;
+        }
+        ALOGW("Failed to query the plane layouts from gralloc, guessing");
+    }
+
+    // Layout minigbm uses for NV12 video decoder buffers.
+    const uint64_t stride = (static_cast<uint64_t>(mCodedSize.width) + 15) & ~uint64_t{15};
+    layouts.numPlanes = 2;
+    layouts.offsets[0] = 0;
+    layouts.strides[0] = stride;
+    layouts.offsets[1] = stride * mCodedSize.height;
+    layouts.strides[1] = stride;
+    return layouts;
+}
+
+bool StatelessV4L2Decoder::allocFrame(CcFrameDesc* desc) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    if (mAvailableFrames.empty() || mError) {
+        return false;
+    }
+
+    VideoFramePool::FrameWithBlockId frameWithBlockId = std::move(mAvailableFrames.front());
+    mAvailableFrames.pop_front();
+    std::unique_ptr<VideoFrame>& frame = frameWithBlockId.first;
+    const uint32_t blockId = frameWithBlockId.second;
+
+    if (!mPlaneLayouts) {
+        mPlaneLayouts = queryPlaneLayouts(*frame);
+    }
+    if (frame->getFDs().empty()) {
+        ALOGE("Output frame of block %u has no fd", blockId);
+        onError();
+        return false;
+    }
+    const int fd = dup(frame->getFDs()[0]);
+    if (fd < 0) {
+        ALOGE("Failed to dup the fd of block %u", blockId);
+        onError();
+        return false;
+    }
+
+    const uint64_t token = mNextToken++;
+    desc->token = token;
+    desc->fd = fd;
+    desc->fourcc = V4L2_PIX_FMT_NV12;
+    desc->width = mCodedSize.width;
+    desc->height = mCodedSize.height;
+    desc->num_planes = mPlaneLayouts->numPlanes;
+    for (uint32_t i = 0; i < mPlaneLayouts->numPlanes; ++i) {
+        desc->offsets[i] = mPlaneLayouts->offsets[i];
+        desc->strides[i] = mPlaneLayouts->strides[i];
+    }
+
+    ALOGV("%s(): block %u as token %" PRIu64, __func__, blockId, token);
+    mBlockIdToToken[blockId] = token;
+    mFramesAtDecoder.emplace(token, FrameAtDecoder{std::move(frame), blockId, mPoolGeneration});
+
+    // Keep the next frame ready for the following picture.
+    tryFetchVideoFrame();
+    return true;
+}
+
+void StatelessV4L2Decoder::releaseFrame(uint64_t token) {
+    ALOG_ASSERT(mTaskRunner->RunsTasksInCurrentSequence());
+
+    auto it = mFramesAtDecoder.find(token);
+    if (it == mFramesAtDecoder.end()) {
+        ALOGE("Release of unknown frame %" PRIu64, token);
+        return;
+    }
+    FrameAtDecoder entry = std::move(it->second);
+    mFramesAtDecoder.erase(it);
+    ALOGV("%s(): token %" PRIu64 " (block %u)", __func__, token, entry.blockId);
+
+    if (entry.poolGeneration != mPoolGeneration) {
+        return;
+    }
+
+    auto blockIt = mBlockIdToToken.find(entry.blockId);
+    if (blockIt != mBlockIdToToken.end() && blockIt->second == token) {
+        mBlockIdToToken.erase(blockIt);
+    }
+
+    if (entry.frame) {
+        // Never output (e.g. dropped by a flush): reuse it directly.
+        mAvailableFrames.emplace_back(std::move(entry.frame), entry.blockId);
+    } else {
+        auto deferredIt = mDeferredFrames.find(entry.blockId);
+        if (deferredIt != mDeferredFrames.end()) {
+            mAvailableFrames.emplace_back(std::move(deferredIt->second), entry.blockId);
+            mDeferredFrames.erase(deferredIt);
+        }
+    }
+
+    if (mNumFramesNeeded > 0 && mAvailableFrames.size() >= mNumFramesNeeded) {
+        schedulePump();
+    }
+}
+
+// static
+bool StatelessV4L2Decoder::AllocFrameThunk(void* ctx, CcFrameDesc* desc) {
+    return static_cast<StatelessV4L2Decoder*>(ctx)->allocFrame(desc);
+}
+
+// static
+void StatelessV4L2Decoder::ReleaseFrameThunk(void* ctx, uint64_t token) {
+    static_cast<StatelessV4L2Decoder*>(ctx)->releaseFrame(token);
+}
+
+void StatelessV4L2Decoder::onError() {
+    if (mError) {
+        return;
+    }
+    mError = true;
+    // May be called from inside a cros-codecs callback: report from a fresh task.
+    mTaskRunner->PostTask(FROM_HERE,
+                          ::base::BindOnce(&StatelessV4L2Decoder::notifyError, mWeakThis));
+}
+
+void StatelessV4L2Decoder::notifyError() {
+    mErrorCb.Run();
+}
+
+}  // namespace android
