diff --git a/audio/aidl/default/include/core-impl/GruAnalogMixer.h b/audio/aidl/default/include/core-impl/GruAnalogMixer.h
--- a/audio/aidl/default/include/core-impl/GruAnalogMixer.h
+++ b/audio/aidl/default/include/core-impl/GruAnalogMixer.h
@@ -0,0 +1,101 @@
+#pragma once
+
+extern "C" {
+#include <tinyalsa/asoundlib.h>
+}
+
+#include <android-base/logging.h>
+
+namespace aidl::android::hardware::audio::core {
+
+// DA7219 powers up with the headphone path open: MIXOUT_*_SELECT is 0, so
+// the DAC never reaches the mixer, and the DAC and headphone mute bits are
+// set. pcmC0D2 then plays into a muted codec while Speakers Switch is off.
+inline void configureGruAnalogOutput(bool headphone) {
+    struct mixer* mixer = mixer_open(0);
+    if (mixer == nullptr) {
+        LOG(ERROR) << __func__ << ": mixer_open failed";
+        return;
+    }
+    auto setValues = [mixer](const char* name, int val) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl == nullptr) {
+            LOG(ERROR) << __func__ << ": missing " << name;
+            return;
+        }
+        const unsigned count = mixer_ctl_get_num_values(ctl);
+        for (unsigned i = 0; i < count; ++i) {
+            if (mixer_ctl_set_value(ctl, i, val) != 0) {
+                LOG(ERROR) << __func__ << ": set " << name << " failed";
+                return;
+            }
+        }
+    };
+    auto setEnum = [mixer](const char* name, const char* value) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl == nullptr) {
+            LOG(ERROR) << __func__ << ": missing " << name;
+            return;
+        }
+        if (mixer_ctl_set_enum_by_string(ctl, value) != 0) {
+            LOG(ERROR) << __func__ << ": enum " << name << "=" << value << " failed";
+        }
+    };
+    setValues("Headphones Switch", headphone ? 1 : 0);
+    setValues("Speakers Switch", headphone ? 0 : 1);
+    if (headphone) {
+        setEnum("Out DACL Mux", "DAIL");
+        setEnum("Out DACR Mux", "DAIR");
+        setValues("Mixer Out FilterL DACL Switch", 1);
+        setValues("Mixer Out FilterR DACR Switch", 1);
+        setValues("ST Mixer Out FilterL Out FilterL Switch", 1);
+        setValues("ST Mixer Out FilterR Out FilterR Switch", 1);
+        setValues("Playback Digital Switch", 1);
+        setValues("Headphone Switch", 1);
+        setValues("Headphone Volume", 57);
+    }
+    mixer_close(mixer);
+    LOG(INFO) << __func__ << ": headphone=" << headphone;
+}
+
+// Out DAIR Mux must stay on ADC. The tone-generator default drives the
+// shared I2S0 data line and zeros the built-in mic.
+inline void configureGruAnalogInput(bool headsetMic) {
+    struct mixer* mixer = mixer_open(0);
+    if (mixer == nullptr) {
+        LOG(ERROR) << __func__ << ": mixer_open failed";
+        return;
+    }
+    auto setValues = [mixer](const char* name, int val) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl == nullptr) {
+            LOG(ERROR) << __func__ << ": missing " << name;
+            return;
+        }
+        const unsigned count = mixer_ctl_get_num_values(ctl);
+        for (unsigned i = 0; i < count; ++i) {
+            if (mixer_ctl_set_value(ctl, i, val) != 0) {
+                LOG(ERROR) << __func__ << ": set " << name << " failed";
+                return;
+            }
+        }
+    };
+    auto setEnum = [mixer](const char* name, const char* value) {
+        struct mixer_ctl* ctl = mixer_get_ctl_by_name(mixer, name);
+        if (ctl == nullptr) {
+            LOG(ERROR) << __func__ << ": missing " << name;
+            return;
+        }
+        if (mixer_ctl_set_enum_by_string(ctl, value) != 0) {
+            LOG(ERROR) << __func__ << ": enum " << name << "=" << value << " failed";
+        }
+    };
+    setEnum("Out DAIL Mux", "ADC");
+    setEnum("Out DAIR Mux", "ADC");
+    setValues("Headset Mic Switch", headsetMic ? 1 : 0);
+    setValues("Int Mic Switch", headsetMic ? 0 : 1);
+    mixer_close(mixer);
+    LOG(INFO) << __func__ << ": headsetMic=" << headsetMic;
+}
+
+}  // namespace aidl::android::hardware::audio::core
