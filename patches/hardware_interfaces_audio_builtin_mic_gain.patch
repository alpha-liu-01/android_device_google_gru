+// The built-in DMIC has no codec gain. Speech peaks far below full scale,
+// so a recording is inaudible until playback is at maximum. 16x is +24 dB.
+void amplifyPcm16(void* buffer, size_t samples) {
+    auto* pcm = static_cast<int16_t*>(buffer);
+    for (size_t i = 0; i < samples; ++i) {
+        const int32_t scaled = static_cast<int32_t>(pcm[i]) * 16;
+        pcm[i] = static_cast<int16_t>(std::clamp(scaled, int32_t{-32768}, int32_t{32767}));
+    }
+}
