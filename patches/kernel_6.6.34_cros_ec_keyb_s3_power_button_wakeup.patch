+static bool cros_ec_keyb_any_bs_pressed(struct cros_ec_keyb *ckdev)
+{
+	struct input_dev *idev = ckdev->bs_idev;
+	int i;
+
+	if (!idev)
+		return false;
+
+	for (i = 0; i < ARRAY_SIZE(cros_ec_keyb_bs); i++) {
+		const struct cros_ec_bs_map *map = &cros_ec_keyb_bs[i];
+
+		if (map->ev_type == EV_KEY && test_bit(map->code, idev->key))
+			return true;
+	}
+
+	return false;
+}
