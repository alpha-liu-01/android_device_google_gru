 /*
+ * The EC timestamp did not advance, so the samples cannot be spread against
+ * the previous batch. Push the newest one at last_ts + one period and leave
+ * a one-sample anchor. Remembering the whole batch (last_len = batch_len,
+ * penul_len = 0) makes every later sample rewind into the same drop.
+ */
+static struct cros_ec_sensors_ring_sample *
+cros_ec_sensor_ring_emit_forward(struct cros_ec_sensorhub *sensorhub, int id,
+				 struct cros_ec_sensors_ring_sample *first,
+				 struct cros_ec_sensors_ring_sample *last_out)
+{
+	struct cros_ec_sensors_ts_batch_state *st = &sensorhub->batch_state[id];
+	struct cros_ec_sensors_ring_sample *s, *last = NULL, *end = first;
+	s64 base, ts;
+	int dropped = 0;
+
+	for (s = first; s < last_out; s++) {
+		if (s->sensor_id != id)
+			continue;
+		if (s->flag & MOTIONSENSE_SENSOR_FLAG_FLUSH)
+			break;
+		if (last && s->timestamp != last->timestamp)
+			break;
+		last = s;
+		end = s;
+		dropped++;
+	}
+
+	base = st->last_ts;
+	if (last && last->timestamp > base)
+		base = last->timestamp;
+	if (base < CROS_EC_SENSORHUB_FALLBACK_PERIOD_NS)
+		base = cros_ec_get_time_ns();
+	ts = base + CROS_EC_SENSORHUB_FALLBACK_PERIOD_NS;
+
+	if (last) {
+		last->timestamp = ts;
+		cros_sensorhub_send_sample(sensorhub, last);
+		dropped--;
+	}
+	if (dropped > 0)
+		dev_warn_ratelimited(sensorhub->dev,
+				     "Sensor %d: lost %d samples when spreading\n",
+				     id, dropped);
+
+	st->penul_ts = ts - CROS_EC_SENSORHUB_FALLBACK_PERIOD_NS;
+	st->penul_len = 1;
+	st->last_ts = ts;
+	st->last_len = 1;
+	if (st->newest_sensor_event < ts)
+		st->newest_sensor_event = ts;
+	return end + 1;
+}
