+static bool cros_usbpd_charger_is_port_connected(struct port_data *port)
+{
+	struct charger_data *charger = port->charger;
+	struct ec_params_usb_pd_control pd_control;
+	struct ec_response_usb_pd_control_v1 resp;
+	int ret;
+
+	if (cros_usbpd_charger_port_is_dedicated(port))
+		return true;
+
+	pd_control.port = port->port_number;
+	pd_control.role = USB_PD_CTRL_ROLE_NO_CHANGE;
+	pd_control.mux = USB_PD_CTRL_MUX_NO_CHANGE;
+	pd_control.swap = USB_PD_CTRL_SWAP_NONE;
+	ret = cros_usbpd_charger_ec_command(charger, 1,
+					    EC_CMD_USB_PD_CONTROL,
+					    &pd_control, sizeof(pd_control),
+					    &resp, sizeof(resp));
+	if (ret < 0)
+		return true;
+
+	return !!(resp.enabled & PD_CTRL_RESP_ENABLED_CONNECTED);
+}
