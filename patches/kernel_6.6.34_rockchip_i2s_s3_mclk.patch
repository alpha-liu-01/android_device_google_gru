+/*
+ * S3 resets the CRU fractional divider latch. The register still reads back
+ * the old numerator/denominator and the clk core still reports 12.288 MHz,
+ * but the hardware falls back to parent/20 (80 MHz). clk_set_rate() of the
+ * cached rate is a no-op, so step away and back. Also drop the enable count
+ * across that, because a CRU gate reset leaves the gate disabled while the
+ * enable count stays non-zero.
+ */
+static int rockchip_i2s_sync_mclk(struct rk_i2s_dev *i2s)
+{
+	unsigned long rate = clk_get_rate(i2s->mclk);
+	int ret = 0;
+
+	if (!rate)
+		return 0;
+
+	clk_disable_unprepare(i2s->mclk);
+	ret = clk_set_rate(i2s->mclk, rate / 2);
+	if (!ret)
+		ret = clk_set_rate(i2s->mclk, rate);
+	clk_prepare_enable(i2s->mclk);
+	if (ret)
+		dev_err(i2s->dev, "failed to reprogram mclk: %d\n", ret);
+
+	return ret;
+}
+
 static int i2s_runtime_suspend(struct device *dev)
 {
 	struct rk_i2s_dev *i2s = dev_get_drvdata(dev);
@@ -112,10 +139,25 @@
 	regcache_mark_dirty(i2s->regmap);
 
 	ret = regcache_sync(i2s->regmap);
-	if (ret)
+	if (ret) {
 		clk_disable_unprepare(i2s->mclk);
+		return ret;
+	}
 
-	return ret;
+	regmap_write(i2s->regmap, I2S_CLR, 0);
+
+	return rockchip_i2s_sync_mclk(i2s);
+}
+
+static int i2s_system_resume(struct device *dev)
+{
+	struct rk_i2s_dev *i2s = dev_get_drvdata(dev);
+
+	/* Already runtime-suspended: the next PCM open resumes and syncs. */
+	if (pm_runtime_status_suspended(dev))
+		return 0;
+
+	return rockchip_i2s_sync_mclk(i2s);
 }
 
