+/*
+ * Stop XFER, then clear the FIFOs. The clear bit self-clears once mclk
+ * has produced a few cycles. After S3 that can take longer than the
+ * upstream 200us poll, and a failed STOP used to abort the DAI trigger
+ * so every later open stayed silent. Keep going after a timeout.
+ */
+static int rockchip_i2s_clear(struct rk_i2s_dev *i2s)
 {
 	unsigned int val = 0;
+	int ret;
+
+	/* A stuck CLR (left behind when mclk was absent) blocks XFER. */
+	regmap_write(i2s->regmap, I2S_CLR, 0);
+
+	ret = regmap_update_bits(i2s->regmap, I2S_XFER,
+				 I2S_XFER_TXS_START | I2S_XFER_RXS_START,
+				 I2S_XFER_TXS_STOP | I2S_XFER_RXS_STOP);
+	if (ret < 0)
+		return ret;
+	udelay(150);
+	ret = regmap_update_bits(i2s->regmap, I2S_CLR,
+				 I2S_CLR_TXC | I2S_CLR_RXC,
+				 I2S_CLR_TXC | I2S_CLR_RXC);
+	if (ret < 0)
+		return ret;
+	/* 200us is not enough if mclk was just re-enabled after S3. */
+	ret = regmap_read_poll_timeout_atomic(i2s->regmap, I2S_CLR, val,
+					      val == 0, 20, 5000);
+	if (ret)
+		dev_warn(i2s->dev, "fail to clear: %d\n", ret);
+	/*
+	 * Returning the timeout used to fail the DAI trigger and left every
+	 * later open unusable. The FIFO clear is best-effort.
+	 */
+	return 0;
+}
