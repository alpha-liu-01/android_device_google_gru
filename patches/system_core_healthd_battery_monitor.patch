@@ -318,6 +318,25 @@ static BatteryMonitor::PowerSupplyType readPowerSupplyType(const String8& path)
     if (!ret)
         *ret = BatteryMonitor::ANDROID_POWER_SUPPLY_TYPE_UNKNOWN;
 
+    if (*ret == BatteryMonitor::ANDROID_POWER_SUPPLY_TYPE_USB) {
+        std::string pathStr(path.c_str());
+        auto pos = pathStr.rfind("/type");
+        if (pos != std::string::npos) {
+            String8 usbTypePath((pathStr.substr(0, pos) + "/usb_type").c_str());
+            std::string usbTypeBuf;
+            if (readFromFile(usbTypePath, &usbTypeBuf) > 0) {
+                if (usbTypeBuf.find("[PD]") != std::string::npos ||
+                    usbTypeBuf.find("[PD_DRP]") != std::string::npos ||
+                    usbTypeBuf.find("[DCP]") != std::string::npos ||
+                    usbTypeBuf.find("[CDP]") != std::string::npos ||
+                    usbTypeBuf.find("[C]") != std::string::npos ||
+                    usbTypeBuf.find("[BrickID]") != std::string::npos) {
+                    return BatteryMonitor::ANDROID_POWER_SUPPLY_TYPE_AC;
+                }
+            }
+        }
+    }
+
     return static_cast<BatteryMonitor::PowerSupplyType>(*ret);
 }
 
