+    fn decode_term_subexp(bd: &mut BoolDecoder) -> Result<usize, String> {
+        if !bd.read_bool().map_err(|e| e.to_string())? {
+            return bd.read_uint::<usize>(4).map_err(|e| e.to_string());
+        }
+        if !bd.read_bool().map_err(|e| e.to_string())? {
+            return Ok(bd.read_uint::<usize>(4).map_err(|e| e.to_string())? + 16);
+        }
+        if !bd.read_bool().map_err(|e| e.to_string())? {
+            return Ok(bd.read_uint::<usize>(5).map_err(|e| e.to_string())? + 32);
+        }
+        let v = bd.read_uint::<usize>(7).map_err(|e| e.to_string())?;
+        let m = (1usize << 8) - 191;
+        let uniform = if v < m {
+            v
+        } else {
+            let bit = bd.read_bool().map_err(|e| e.to_string())? as usize;
+            (v << 1) - m + bit
+        };
+        Ok(uniform + 64)
+    }
+
+    fn read_diff_update_prob(bd: &mut BoolDecoder) -> Result<u8, String> {
+        if bd.read_bool_with_prob(DIFF_UPDATE_PROB).map_err(|e| e.to_string())? {
+            let delp = Self::decode_term_subexp(bd)?;
+            if delp >= INV_MAP_TABLE.len() {
+                return Err(format!("Invalid delta prob index {}", delp));
+            }
+            Ok(INV_MAP_TABLE[delp])
+        } else {
+            Ok(0)
+        }
+    }
+
+    fn read_mv_update_prob(bd: &mut BoolDecoder) -> Result<u8, String> {
+        if bd.read_bool_with_prob(MV_UPDATE_PROB).map_err(|e| e.to_string())? {
+            let v = bd.read_uint::<u8>(7).map_err(|e| e.to_string())?;
+            Ok((v << 1) | 1)
+        } else {
+            Ok(0)
+        }
+    }
+
+    fn parse_compressed_header(data: &[u8], hdr: &mut Header) -> Result<(), String> {
+        let start = hdr.uncompressed_header_size_in_bytes as usize;
+        let size = hdr.header_size_in_bytes as usize;
+        if size == 0 || start + size > data.len() {
+            return Ok(());
+        }
+
+        let mut bd = BoolDecoder::new(&data[start..start + size]);
+        // VP9 compressed header starts with a 1-bit marker which must be 0.
+        let marker = bd.read_bool().map_err(|e| e.to_string())?;
+        if marker {
+            return Err("Invalid VP9 compressed header marker bit".to_string());
+        }
+
+        let ch = &mut hdr.compressed_header;
+
+        // 6.3.1 tx_mode()
+        if hdr.lossless {
+            ch.tx_mode = 0; // ONLY_4X4
+        } else {
+            let mut tx_mode = bd.read_uint::<u8>(2).map_err(|e| e.to_string())?;
+            if tx_mode == 3 {
+                tx_mode += bd.read_bool().map_err(|e| e.to_string())? as u8;
+            }
+            ch.tx_mode = tx_mode;
+            if ch.tx_mode == 4 {
+                // TX_MODE_SELECT: 6.3.2 tx_mode_probs()
+                for i in 0..2 {
+                    ch.tx8[i][0] = Self::read_diff_update_prob(&mut bd)?;
+                }
+                for i in 0..2 {
+                    for j in 0..2 {
+                        ch.tx16[i][j] = Self::read_diff_update_prob(&mut bd)?;
+                    }
+                }
+                for i in 0..2 {
+                    for j in 0..3 {
+                        ch.tx32[i][j] = Self::read_diff_update_prob(&mut bd)?;
+                    }
+                }
+            }
+        }
+
+        // 6.3.7 read_coef_probs()
+        let max_tx_size = match ch.tx_mode {
+            0 => 0,
+            1 => 1,
+            2 => 2,
+            _ => 3,
+        };
+        for tx_size in 0..=max_tx_size {
+            let update_probs = bd.read_bool().map_err(|e| e.to_string())?;
+            if update_probs {
+                for i in 0..2 {
+                    for j in 0..2 {
+                        for k in 0..6 {
+                            let max_l = if k == 0 { 3 } else { 6 };
+                            for l in 0..max_l {
+                                for m in 0..3 {
+                                    ch.coef[tx_size][i][j][k][l][m] =
+                                        Self::read_diff_update_prob(&mut bd)?;
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        // 6.3.8 read_skip_prob()
+        for k in 0..3 {
+            ch.skip[k] = Self::read_diff_update_prob(&mut bd)?;
+        }
+
+        let frame_is_intra = matches!(hdr.frame_type, FrameType::KeyFrame) || hdr.intra_only;
+        if !frame_is_intra {
+            // 6.3.9 read_inter_mode_probs()
+            for i in 0..7 {
+                for j in 0..3 {
+                    ch.inter_mode[i][j] = Self::read_diff_update_prob(&mut bd)?;
+                }
+            }
+
+            // 6.3.10 read_interp_filter_probs()
+            if matches!(hdr.interpolation_filter, InterpolationFilter::Switchable) {
+                for i in 0..4 {
+                    for j in 0..2 {
+                        ch.interp_filter[i][j] = Self::read_diff_update_prob(&mut bd)?;
+                    }
+                }
+            }
+
+            // 6.3.11 read_is_inter_probs()
+            for i in 0..4 {
+                ch.is_inter[i] = Self::read_diff_update_prob(&mut bd)?;
+            }
+
+            // 6.3.12 frame_reference_mode()
+            let mut compound_reference_allowed = false;
+            for i in 1..REFS_PER_FRAME {
+                if hdr.ref_frame_sign_bias[i + 1] != hdr.ref_frame_sign_bias[1] {
+                    compound_reference_allowed = true;
+                }
+            }
+            hdr.reference_mode = if compound_reference_allowed {
+                let non_single = bd.read_bool().map_err(|e| e.to_string())?;
+                if !non_single {
+                    0 // SINGLE_REFERENCE
+                } else {
+                    let reference_select = bd.read_bool().map_err(|e| e.to_string())?;
+                    if reference_select {
+                        2 // REFERENCE_MODE_SELECT
+                    } else {
+                        1 // COMPOUND_REFERENCE
+                    }
+                }
+            } else {
+                0 // SINGLE_REFERENCE
+            };
+
+            // 6.3.13 frame_reference_mode_probs()
+            if hdr.reference_mode == 2 {
+                for i in 0..5 {
+                    ch.comp_mode[i] = Self::read_diff_update_prob(&mut bd)?;
+                }
+            }
+            if hdr.reference_mode != 1 {
+                for i in 0..5 {
+                    ch.single_ref[i][0] = Self::read_diff_update_prob(&mut bd)?;
+                    ch.single_ref[i][1] = Self::read_diff_update_prob(&mut bd)?;
+                }
+            }
+            if hdr.reference_mode != 0 {
+                for i in 0..5 {
+                    ch.comp_ref[i] = Self::read_diff_update_prob(&mut bd)?;
+                }
+            }
+
+            // 6.3.14 read_y_mode_probs()
+            for i in 0..4 {
+                for j in 0..9 {
+                    ch.y_mode[i][j] = Self::read_diff_update_prob(&mut bd)?;
+                }
+            }
+
+            // 6.3.15 read_partition_probs()
+            for i in 0..16 {
+                for j in 0..3 {
+                    ch.partition[i][j] = Self::read_diff_update_prob(&mut bd)?;
+                }
+            }
+
+            // 6.3.16 mv_probs()
+            for j in 0..3 {
+                ch.mv.joint[j] = Self::read_mv_update_prob(&mut bd)?;
+            }
+            for i in 0..2 {
+                ch.mv.sign[i] = Self::read_mv_update_prob(&mut bd)?;
+                for j in 0..10 {
+                    ch.mv.classes[i][j] = Self::read_mv_update_prob(&mut bd)?;
+                }
+                ch.mv.class0_bit[i] = Self::read_mv_update_prob(&mut bd)?;
+                for j in 0..10 {
+                    ch.mv.bits[i][j] = Self::read_mv_update_prob(&mut bd)?;
+                }
+            }
+            for i in 0..2 {
+                for j in 0..2 {
+                    for k in 0..3 {
+                        ch.mv.class0_fr[i][j][k] = Self::read_mv_update_prob(&mut bd)?;
+                    }
+                }
+                for k in 0..3 {
+                    ch.mv.fr[i][k] = Self::read_mv_update_prob(&mut bd)?;
+                }
+            }
+            if hdr.allow_high_precision_mv {
+                for i in 0..2 {
+                    ch.mv.class0_hp[i] = Self::read_mv_update_prob(&mut bd)?;
+                    ch.mv.hp[i] = Self::read_mv_update_prob(&mut bd)?;
+                }
+            }
+        }
+
+        Ok(())
+    }
