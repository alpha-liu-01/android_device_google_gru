   -zygote
 } {
   privapp_data_file
@@ -1818,6 +1819,7 @@ neverallow {
   -artd # compile secondary dex files
   -installd
   -rs # spawned by appdomain, so carryover the exception above
+  -stylusctrl
 } {
   privapp_data_file
